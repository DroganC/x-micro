{
  "extends": "./src/.umi/tsconfig.json",
  "compilerOptions": {
   "target": "ES2020",
   "module": "ESNext",
   "lib": ["ES2020","DOM","DOM.Iterable"],
   "skipLibCheck": true,

   "moduleResolution": "node",
   "resolveJsonModule": true,
   "noEmit": true,
   "jsx": "react-jsx",

   "strict": false,
   "noUnusedLocals": true,
   "noUnusedParameters": false,
   "noImplicitAny": false,
   "noFallthroughCasesInSwitch": true
  }
}
